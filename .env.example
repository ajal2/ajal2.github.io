# Copy to .env (gitignored) and fill in. Only needed to run the Notion sync
# locally — the site build and dev server do not need it.
#
# A Notion internal-integration token for the "site-sync" integration, which
# must be connected to the "Filing Cabinet" database. See agent/SYNC.md for how
# to create it. In CI this is the NOTION_TOKEN GitHub Actions secret instead.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
