---
// The taped card grid, shared by The Files and every tag section, so a story
// looks the same wherever it surfaces. Ported from the Claude Design handoff
// (design_handoff_case_studies/Case Studies - Index.dc.html).
import { parseStoryBody } from '../lib/story-body.mjs';

interface Props {
  stories: any[];
  empty?: string;
}
const { stories, empty = 'Nothing filed here yet.' } = Astro.props;

const ROTS = [-1.1, 0.9, -0.6, 1.2, -0.4, 0.7];
// Undated stories sort last rather than crashing the page — Period is optional
// in Notion on purpose.
const when = (s: any) => (s.data.periodStart ? s.data.periodStart.valueOf() : -Infinity);

const cards = [...stories]
  .sort((a, b) => when(b) - when(a))
  .map((s, i) => {
    const d = s.data;
    const { summary } = parseStoryBody(s.body);
    return {
      ...d,
      // The manila block needs typed words: the note, or the story's own
      // summary line, or an honest placeholder for unwritten drafts.
      // (|| not ?? — the parser returns '' for missing summaries.)
      noteText: d.typedNote || summary || '…file being written.',
      tagLine: (d.tags ?? []).join(' / ').toUpperCase(),
      meta: [d.org, d.periodStart ? `’${String(d.periodStart.getUTCFullYear()).slice(2)}` : null]
        .filter(Boolean)
        .join(' · '),
      rot: ROTS[i % ROTS.length],
      delay: (0.05 + (i % 6) * 0.06).toFixed(2),
    };
  });
---

{cards.length === 0 && <p class="cs-empty">{empty}</p>}

<div class="cs-grid">
  {cards.map((c) => (
    <a class="cs-card" href={`/stories/${c.slug}/`} style={`transform:rotate(${c.rot}deg);animation-delay:${c.delay}s`}>
      <div class="cs-tapeL"></div>
      <div class="cs-tapeR"></div>
      <div class="cs-top">
        <span class="cs-stamp">{c.stamp}</span>
        <span class="cs-tagline">{c.tagLine}{!c.live && <b class="cs-draft"> · DRAFT</b>}</span>
      </div>
      {c.photo ? (
        <div class="cs-photo"><img src={c.photo} alt={c.printCaption ?? c.name} loading="lazy" /></div>
      ) : (
        <div class="cs-nophoto">
          <div class="cs-nophoto-note">“{c.noteText}”</div>
          <div class="cs-nophoto-label">NO PHOTOGRAPH ON FILE</div>
        </div>
      )}
      <h2 class="cs-name">{c.name}</h2>
      {c.photo && <div class="cs-note">“{c.noteText}”</div>}
      <div class="cs-meta">{c.meta}</div>
    </a>
  ))}
</div>

