---
// Interim shell for inner pages: the field-journal palette and type on a
// quiet paper sheet. Deliberately unambitious — the real case-study design
// arrives as Aryan's next Claude Design handoff and replaces the innards.
// Palette, fonts, and base styles come from src/styles/tokens.css (via Head).
import Head from '../components/Head.astro';
import JournalNav from '../components/JournalNav.astro';

interface Props {
  title?: string;
  description?: string;
  person?: boolean;
}
const { title, description, person } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {title} {description} {person} />
  </head>
  <body>
    <JournalNav themeToggle />
    <main class="js-page">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  /* Palette, fonts, base body, ::selection, focus, reduced-motion all come
     from src/styles/tokens.css (via Head). Only the shell layout below. */
  .js-page { max-width: 780px; margin: 0 auto; padding: 92px 20px 120px; }
  .js-mono { font-family: var(--font-mono); }
</style>
