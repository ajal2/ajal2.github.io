---
import { getCollection, render } from 'astro:content';
import JournalShell from '../../layouts/JournalShell.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const meta = [String(d.date.getFullYear()), d.status, ...d.stack].join(' · ');
---

<JournalShell title={`${d.title} — Aryan Jalota`} description={d.summary}>
  <a class="js-crumb" href="/">← THE DESK</a>

  <article class="js-sheet pj">
    <header>
      <p class="pj-meta js-mono">{meta}</p>
      <h1 class="pj-title">{d.title}</h1>
      <p class="pj-summary">{d.summary}</p>
      {d.outcome && <p class="pj-outcome">{d.outcome}</p>}
      <p class="pj-links js-mono">
        <a href={d.repo}>View on GitHub ↗</a>
        {d.demo && <a href={d.demo}>Live ↗</a>}
      </p>
    </header>

    <div class="pj-body">
      <Content />
    </div>

    {d.draftedBy === 'agent' && (
      <p class="pj-note js-mono">Drafted by this site's agent from the repo README — reviewed by a human before merge.</p>
    )}
  </article>
</JournalShell>

<style>
  .pj-meta { margin: 0; font-size: var(--text-stamp); letter-spacing: var(--track-wide); text-transform: uppercase; color: var(--stamp); }
  .pj-title { margin: 10px 0 0; font-size: var(--text-title); font-weight: 900; letter-spacing: var(--track-tight); line-height: 1.12; color: var(--ink-title); }
  .pj-summary { margin: 14px 0 0; font-size: var(--text-body); line-height: 1.5; color: #33302a; max-width: 52ch; }
  .pj-outcome { margin: 10px 0 0; font-weight: 600; color: var(--ink-title); max-width: 52ch; }
  .pj-links { margin: 18px 0 0; font-size: var(--text-caption); display: flex; gap: 18px; }
  .pj-links a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .pj-body { margin-top: 28px; border-top: 1px solid #ddd6c4; padding-top: 22px; font-size: var(--text-body); line-height: 1.65; color: #33302a; }
  .pj-body :global(p) { margin: 0 0 14px; }
  .pj-body :global(h2), .pj-body :global(h3) { margin: 26px 0 10px; font-family: var(--font-mono); font-size: var(--text-caption); font-weight: 700; letter-spacing: var(--track-stamp); text-transform: uppercase; color: var(--stamp); border-bottom: 1px solid #ddd6c4; padding-bottom: 6px; }
  .pj-body :global(ul) { padding-left: 20px; margin: 0 0 14px; }
  .pj-body :global(code) { font-family: var(--font-mono); font-size: 0.92em; }
  .pj-note { margin: 30px 0 0; font-size: 11px; letter-spacing: 0.5px; color: var(--stamp); }
</style>
