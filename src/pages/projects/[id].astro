---
import { getCollection, render } from 'astro:content';
import JournalShell from '../../layouts/JournalShell.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const meta = [String(d.date.getFullYear()), d.status, ...d.stack].join(' · ');
---

<JournalShell title={`${d.title} — Aryan Jalota`} description={d.summary}>
  <a class="js-crumb" href="/">← THE DESK</a>

  <article class="js-sheet pj">
    <header>
      <p class="pj-meta js-mono">{meta}</p>
      <h1 class="pj-title">{d.title}</h1>
      <p class="pj-summary">{d.summary}</p>
      {d.outcome && <p class="pj-outcome">{d.outcome}</p>}
      <p class="pj-links js-mono">
        <a href={d.repo}>View on GitHub ↗</a>
        {d.demo && <a href={d.demo}>Live ↗</a>}
      </p>
    </header>

    <div class="pj-body">
      <Content />
    </div>

    {d.draftedBy === 'agent' && (
      <p class="pj-note js-mono">Drafted by this site's agent from the repo README — reviewed by a human before merge.</p>
    )}
  </article>
</JournalShell>

<style>
  .pj-meta { margin: 0; font-size: 10.5px; letter-spacing: 1.5px; text-transform: uppercase; color: #8b8574; }
  .pj-title { margin: 10px 0 0; font-size: clamp(24px, 5vw, 32px); font-weight: 900; font-stretch: 112%; letter-spacing: -0.5px; line-height: 1.12; color: #211f19; }
  .pj-summary { margin: 14px 0 0; font-size: 16px; line-height: 1.5; color: #33302a; max-width: 52ch; }
  .pj-outcome { margin: 10px 0 0; font-weight: 600; color: #211f19; max-width: 52ch; }
  .pj-links { margin: 18px 0 0; font-size: 12px; display: flex; gap: 18px; }
  .pj-links a { color: #2b52b8; text-decoration: underline; text-underline-offset: 3px; }
  .pj-body { margin-top: 28px; border-top: 1px solid #ddd6c4; padding-top: 22px; font-size: 15px; line-height: 1.65; color: #33302a; }
  .pj-body :global(p) { margin: 0 0 14px; }
  .pj-body :global(h2), .pj-body :global(h3) { margin: 26px 0 10px; font-family: 'Courier Prime', monospace; font-size: 12px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #8b8574; border-bottom: 1px solid #ddd6c4; padding-bottom: 6px; }
  .pj-body :global(ul) { padding-left: 20px; margin: 0 0 14px; }
  .pj-body :global(code) { font-family: 'Courier Prime', monospace; font-size: 0.92em; }
  .pj-note { margin: 30px 0 0; font-size: 11px; letter-spacing: 0.5px; color: #8b8574; }
</style>
