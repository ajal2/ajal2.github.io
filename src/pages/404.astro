---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Aryan Jalota">
  <div class="nf">
    <p class="nf-code" aria-hidden="true">४०४</p>
    <h1 class="nf-title">Page not found</h1>
    <p>That's 404 in Devanagari numerals. <a href="/">Back to the front page</a>.</p>
  </div>
</BaseLayout>

<style>
  .nf {
    padding-top: clamp(4rem, 18vh, 8rem);
  }

  .nf-code {
    font-size: clamp(3.5rem, 12vw, 5.5rem);
    font-weight: 700;
    color: var(--madder);
    line-height: 1;
  }

  .nf-title {
    font-size: 1.3rem;
    font-weight: 700;
    margin-top: 1rem;
  }

  .nf p:last-child {
    margin-top: 0.5rem;
  }
</style>
