---
// The Files — every live story, whatever its tags. This is the guaranteed
// route into every story: desk prints flip open and tag sections exist too,
// but nothing may depend on those. Membership is pure data — tick Live in
// Notion and it lands here on the next sync.
import { getCollection } from 'astro:content';
import Head from '../../components/Head.astro';
import JournalNav from '../../components/JournalNav.astro';
import StoryCards from '../../components/StoryCards.astro';
import { isPublished } from '../../lib/stories.mjs';

const stories = (await getCollection('stories')).filter(isPublished);
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title="The Files — Aryan Jalota"
      description="Every story, filed: engagements, projects, and field notes — the problem, what I did, what it was worth."
    />
  </head>
  <body>
    <JournalNav active="files" themeToggle />

    <div class="cs-wrap">
      <h1 class="cs-h1">THE FILES</h1>
      <StoryCards
        stories={stories}
        empty="Nothing filed yet. The cabinet is being organized — check back soon."
      />
    </div>

    <style is:global>
      /* Palette, fonts, and base styles come from src/styles/tokens.css (via Head). */
      .cs-wrap { max-width: 1420px; margin: 0 auto; padding: 88px 40px 110px; }
      .cs-h1 { margin: 0; font-size: var(--text-display); line-height: 1; font-weight: 900; letter-spacing: -0.8px; color: var(--ink); }
      @media (max-width: 420px) { .cs-wrap { padding: 76px 20px 90px; } }
    </style>
  </body>
</html>
